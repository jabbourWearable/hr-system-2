# Copy to .env.local for local development, and set the same three vars in
# Vercel's project settings for deployment (spec §9). See ARCHITECTURE.md
# for where to find these values in the Supabase dashboard.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role
# Server-only — never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
